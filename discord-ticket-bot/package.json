{
  "name": "relay",
  "version": "2.0.0",
  "private": true,
  "description": "Relay Discord ticket system — HTTP/serverless runtime",
  "scripts": {
    "dev": "next dev",
    "build": "tsx --test src/runtime/*.test.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "test": "tsx --test src/runtime/*.test.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
