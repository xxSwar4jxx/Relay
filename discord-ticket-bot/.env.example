# Discord bot token (Discord Developer Portal -> Bot -> Token). Never commit the real value.
DISCORD_TOKEN=

# Application (client) ID, used for slash command registration.
CLIENT_ID=

# Optional: set to a guild ID during development for instant (guild-scoped) command deployment.
# Leave blank to register commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# Optional: path to the SQLite database file. Defaults to ./data/tickets.sqlite
DATABASE_PATH=

# Optional: log level - debug | info | warn | error. Defaults to info.
LOG_LEVEL=
